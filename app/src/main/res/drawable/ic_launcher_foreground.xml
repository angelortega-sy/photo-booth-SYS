<!--
  Cabina de Fotos launcher mark: a flat Syscom-blue camera with a cream lens.
  Source of truth: design/logos/build_logos.py (variant a-solid).
  Geometry stays inside the 66dp circular safe zone of the adaptive icon.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- viewfinder hump -->

        android:pathData="M48,26 H60 A5,5 0 0 1 65,31 V34 A5,5 0 0 1 60,39 H48 A5,5 0 0 1 43,34 V31 A5,5 0 0 1 48,26 Z"
        android:fillColor="#0B63CE" />

